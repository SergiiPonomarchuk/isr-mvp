rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // R0 (2026-11-07): open prototype access until 2027-06-30, except the
    // server-only issue_drafts (written and read by Cloud Functions only).
    // A4 (2026-11-10): analyzer_logs is server-only as well (it holds the Analyzer's
    // prompts and outputs).
    // To be replaced by real access rules in roadmap stage 5.
    match /{collection}/{document=**} {
      allow read, write: if request.time < timestamp.date(2027, 6, 30)
                         && collection != 'issue_drafts'
                         && collection != 'analyzer_logs';
    }
  }
}
